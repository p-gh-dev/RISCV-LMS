AR = /usr/bin/ar
# Use rv64gc_glibc_2.36 for VF2, rv64gc for 
CC = /home/build/testing/RISCV/rv64gc_glibc_2.36/bin/riscv64-unknown-linux-gnu-gcc
CFLAGS = -Wall -march=rv64gc -O3 -g -I/home/build/testing/openssl_riscv/install/include
LDFLAGS = -L/home/build/testing/openssl_riscv/install/lib
BUILDDIR = rv64gc_linux

$(BUILDDIR):
	mkdir -p $(BUILDDIR)

all: $(BUILDDIR)/hss_lib.a \
     $(BUILDDIR)/hss_lib_thread.a \
     $(BUILDDIR)/hss_verify.a \
     $(BUILDDIR)/demo \
	 $(BUILDDIR)/demo_st | $(BUILDDIR)

$(BUILDDIR)/hss_lib.a: $(BUILDDIR)/hss.o $(BUILDDIR)/hss_alloc.o $(BUILDDIR)/hss_aux.o $(BUILDDIR)/hss_common.o \
     $(BUILDDIR)/hss_compute.o $(BUILDDIR)/hss_generate.o $(BUILDDIR)/hss_keygen.o $(BUILDDIR)/hss_param.o $(BUILDDIR)/hss_reserve.o \
     $(BUILDDIR)/hss_sign.o $(BUILDDIR)/hss_sign_inc.o $(BUILDDIR)/hss_thread_single.o \
     $(BUILDDIR)/hss_verify.o $(BUILDDIR)/hss_verify_inc.o $(BUILDDIR)/hss_derive.o \
     $(BUILDDIR)/hss_derive.o $(BUILDDIR)/hss_zeroize.o $(BUILDDIR)/lm_common.o \
     $(BUILDDIR)/lm_ots_common.o $(BUILDDIR)/lm_ots_sign.o $(BUILDDIR)/lm_ots_verify.o $(BUILDDIR)/lm_verify.o $(BUILDDIR)/endian.o \
     $(BUILDDIR)/hash.o $(BUILDDIR)/sha256.o $(BUILDDIR)/ossl_sha3.o $(BUILDDIR)/ossl_keccak1600.o $(BUILDDIR)/bh_sha3.o | $(BUILDDIR)
	$(AR) rcs $@ $^

$(BUILDDIR)/hss_lib_thread.a: $(BUILDDIR)/hss.o $(BUILDDIR)/hss_alloc.o $(BUILDDIR)/hss_aux.o $(BUILDDIR)/hss_common.o \
     $(BUILDDIR)/hss_compute.o $(BUILDDIR)/hss_generate.o $(BUILDDIR)/hss_keygen.o $(BUILDDIR)/hss_param.o $(BUILDDIR)/hss_reserve.o \
     $(BUILDDIR)/hss_sign.o $(BUILDDIR)/hss_sign_inc.o $(BUILDDIR)/hss_thread_pthread.o \
     $(BUILDDIR)/hss_verify.o $(BUILDDIR)/hss_verify_inc.o \
     $(BUILDDIR)/hss_derive.o $(BUILDDIR)/hss_zeroize.o $(BUILDDIR)/lm_common.o \
     $(BUILDDIR)/lm_ots_common.o $(BUILDDIR)/lm_ots_sign.o $(BUILDDIR)/lm_ots_verify.o $(BUILDDIR)/lm_verify.o $(BUILDDIR)/endian.o \
     $(BUILDDIR)/hash.o $(BUILDDIR)/sha256.o $(BUILDDIR)/ossl_sha3.o $(BUILDDIR)/ossl_keccak1600.o $(BUILDDIR)/bh_sha3.o | $(BUILDDIR)
	$(AR) rcs $@ $^

$(BUILDDIR)/hss_verify.a: $(BUILDDIR)/hss_verify.o $(BUILDDIR)/hss_verify_inc.o $(BUILDDIR)/hss_common.o $(BUILDDIR)/hss_thread_single.o \
    $(BUILDDIR)/hss_zeroize.o $(BUILDDIR)/lm_common.o $(BUILDDIR)/lm_ots_common.o $(BUILDDIR)/lm_ots_verify.o $(BUILDDIR)/lm_verify.o \
    $(BUILDDIR)/endian.o $(BUILDDIR)/hash.o $(BUILDDIR)/sha256.o $(BUILDDIR)/ossl_sha3.o $(BUILDDIR)/ossl_keccak1600.o $(BUILDDIR)/bh_sha3.o | $(BUILDDIR)
	$(AR) rcs $@ $^

$(BUILDDIR)/demo: demo.c $(BUILDDIR)/hss_lib_thread.a | $(BUILDDIR)
	$(CC) $(CFLAGS) demo.c $(BUILDDIR)/hss_lib_thread.a $(LDFLAGS) -lpthread -lcrypto -o $(BUILDDIR)/demo
	
$(BUILDDIR)/demo_st: demo.c $(BUILDDIR)/hss_lib.a | $(BUILDDIR)
	$(CC) $(CFLAGS) demo.c $(BUILDDIR)/hss_lib.a $(LDFLAGS) -lcrypto -o $(BUILDDIR)/demo_st

